# Copie para .env (na raiz do repositório) e ajuste se quiser:  cp .env.example .env
# Todas as variáveis são opcionais para rodar com Docker; os padrões abaixo funcionam localmente.

# Chave da API do Google Gemini, usada só pela categorização por IA (página /categorizar).
# Gere uma em https://aistudio.google.com/app/apikey
# Sem ela o app funciona normalmente; ao tentar categorizar aparece um aviso pedindo a chave.
# Depois de preencher, aplique com: docker compose up -d
GEMINI_API_KEY=

# Senha do PostgreSQL do docker-compose (usuário e banco: finscan).
# Atenção: a senha é gravada na primeira vez que o volume do banco é criado. Para trocá-la depois,
# apague os dados com `docker compose down -v`.
POSTGRES_PASSWORD=finscan

# --- Apenas para desenvolvimento sem Docker (pnpm dev dentro de frontend/) ---
# Nesse caso crie frontend/.env com GEMINI_API_KEY e a DATABASE_URL abaixo, que aponta para o
# Postgres do compose exposto no host (docker compose up -d db). No Docker ela é montada pelo compose.
# DATABASE_URL=postgresql://finscan:finscan@localhost:5433/finscan
